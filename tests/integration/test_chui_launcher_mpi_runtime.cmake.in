set(runtime_root "@CMAKE_BINARY_DIR@/chui_launcher_mpi_runtime")
set(runtime_run_root "${runtime_root}/outputs")
set(runtime_config "${runtime_root}/launcher_mpi.param.txt")
set(runtime_stdout "${runtime_root}/runtime_stdout.txt")
set(runtime_stderr "${runtime_root}/runtime_stderr.txt")
set(runtime_snapshot_dir "${runtime_run_root}/chui_launcher_mpi_runtime/snapshots")
file(REMOVE_RECURSE "${runtime_root}")
file(MAKE_DIRECTORY "${runtime_root}")
file(WRITE "${runtime_config}" "schema_version = 1\n\n[mode]\nmode = zoom_in\nic_file = generated\nzoom_high_res_region = false\n\n[numerics]\ntime_begin_code = 0.01\ntime_end_code = 0.0101\nmax_global_steps = 1\nhierarchical_max_rung = 0\ngravity_solver = treepm\nhydro_solver = godunov_fv\ntreepm_pm_grid_nx = 16\ntreepm_pm_grid_ny = 16\ntreepm_pm_grid_nz = 16\ntreepm_assignment_scheme = cic\ntreepm_enable_window_deconvolution = true\ntreepm_update_cadence_steps = 1\n\n[analysis]\nenable_diagnostics = false\nenable_halo_workflow = false\n\n[output]\nrun_name = chui_launcher_mpi_runtime\noutput_directory = ${runtime_run_root}\noutput_stem = snap\nrestart_stem = restart\nsnapshot_interval_steps = 8\nsnapshot_layout = single\nwrite_restarts = false\n\n[parallel]\nmpi_ranks_expected = 2\nomp_threads = 1\ngpu_devices = 0\n\n[units]\ncoordinate_frame = comoving\n")
execute_process(
  COMMAND "@CMAKE_CURRENT_SOURCE_DIR@/chui" run "${runtime_config}" --preset "@COSMOSIM_SELECTED_PRESET@"
  RESULT_VARIABLE runtime_result OUTPUT_FILE "${runtime_stdout}" ERROR_FILE "${runtime_stderr}")
if(NOT runtime_result EQUAL 0)
  file(READ "${runtime_stderr}" runtime_err)
  message(FATAL_ERROR "real CHUI launcher + MPI runtime failed (${runtime_result}):\n${runtime_err}")
endif()
if(NOT EXISTS "${runtime_snapshot_dir}/snap_001.hdf5")
  message(FATAL_ERROR "real launcher + MPI runtime did not publish the science snapshot")
endif()
file(READ "${runtime_stdout}" stdout_text)
if(NOT stdout_text MATCHES "\\[CHUI\\]\\[LAUNCH\\].*mode=mpi.*mpi_ranks=2")
  message(FATAL_ERROR "launcher did not infer two ranks from authoritative config: ${stdout_text}")
endif()
string(REGEX MATCHALL "\\[CHUI\\]\\[STEP\\]" step_records "${stdout_text}")
list(LENGTH step_records step_count)
if(NOT step_count EQUAL 1)
  message(FATAL_ERROR "real launcher MPI smoke expected one rank-zero STEP record, got ${step_count}")
endif()
