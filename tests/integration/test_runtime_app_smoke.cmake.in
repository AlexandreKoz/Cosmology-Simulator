set(runtime_smoke_root "@CMAKE_BINARY_DIR@/runtime_app_smoke")
set(runtime_smoke_run_root "${runtime_smoke_root}/outputs")
set(runtime_smoke_config "${runtime_smoke_root}/runtime_smoke.param.txt")
set(runtime_smoke_stdout "${runtime_smoke_root}/runtime_stdout.txt")
set(runtime_smoke_stderr "${runtime_smoke_root}/runtime_stderr.txt")
set(runtime_smoke_run_dir "${runtime_smoke_run_root}/runtime_app_smoke")
set(runtime_smoke_snapshot_dir "${runtime_smoke_run_dir}/snapdir_001")
set(runtime_smoke_snapshot_member "${runtime_smoke_snapshot_dir}/snap_001.hdf5")

file(REMOVE_RECURSE "${runtime_smoke_root}")
file(MAKE_DIRECTORY "${runtime_smoke_root}")

file(WRITE "${runtime_smoke_config}" "schema_version = 1\n\n[mode]\nmode = zoom_in\nic_file = generated\nzoom_high_res_region = false\n\n[numerics]\ntime_begin_code = 0.01\ntime_end_code = 0.0101\nmax_global_steps = 1\nhierarchical_max_rung = 0\ngravity_solver = treepm\nhydro_solver = godunov_fv\ntreepm_pm_grid_nx = 8\ntreepm_pm_grid_ny = 8\ntreepm_pm_grid_nz = 8\ntreepm_asmth_cells = 1.5\ntreepm_rcut_cells = 3.5\ntreepm_assignment_scheme = cic\ntreepm_enable_window_deconvolution = true\ntreepm_update_cadence_steps = 1\n\n[analysis]\nenable_diagnostics = true\nenable_halo_workflow = false\nrun_health_interval_steps = 1\nscience_light_interval_steps = 1\nscience_heavy_interval_steps = 4\n\n[output]\nrun_name = runtime_app_smoke\noutput_directory = ${runtime_smoke_run_root}\noutput_stem = snap\nrestart_stem = restart\nsnapshot_interval_steps = 1\nwrite_restarts = true\n\n[units]\ncoordinate_frame = comoving\n")

execute_process(
  COMMAND "@CMAKE_COMMAND@" -E env
          "COSMOSIM_RUNTIME_PHASE_DIAGNOSTICS=1"
          "@CMAKE_BINARY_DIR@/cosmosim_harness" "${runtime_smoke_config}"
  RESULT_VARIABLE runtime_result
  OUTPUT_FILE "${runtime_smoke_stdout}"
  ERROR_FILE "${runtime_smoke_stderr}"
  TIMEOUT 30)

if(NOT runtime_result EQUAL 0)
  file(READ "${runtime_smoke_stdout}" runtime_out)
  file(READ "${runtime_smoke_stderr}" runtime_err)
  message(FATAL_ERROR
    "cosmosim_harness runtime smoke failed with result ${runtime_result}:\n"
    "stdout:\n${runtime_out}\n"
    "stderr/phase diagnostics:\n${runtime_err}")
endif()

foreach(required_path IN ITEMS
    "${runtime_smoke_run_dir}"
    "${runtime_smoke_run_dir}/normalized_config.param.txt"
    "${runtime_smoke_run_dir}/operational_events.json"
    "${runtime_smoke_run_dir}/profile.json"
    "${runtime_smoke_run_dir}/profile.csv"
    "${runtime_smoke_snapshot_dir}"
    "${runtime_smoke_snapshot_member}"
    "${runtime_smoke_run_dir}/restart_001.hdf5")
  if(NOT EXISTS "${required_path}")
    message(FATAL_ERROR "runtime smoke missing expected artifact: ${required_path}")
  endif()
endforeach()

file(GLOB runtime_smoke_completion_markers
     "${runtime_smoke_snapshot_dir}/snap_001_*.complete")
list(LENGTH runtime_smoke_completion_markers runtime_smoke_completion_marker_count)
if(NOT runtime_smoke_completion_marker_count EQUAL 1)
  message(FATAL_ERROR
    "runtime smoke expected exactly one snapshot-set completion manifest in "
    "${runtime_smoke_snapshot_dir}, found ${runtime_smoke_completion_marker_count}")
endif()
list(GET runtime_smoke_completion_markers 0 runtime_smoke_completion_marker)
file(READ "${runtime_smoke_completion_marker}" runtime_smoke_completion_text)
foreach(required_manifest_contract IN ITEMS
    "schema=chui_snapshot_set_v2"
    "schema_name=chui_science_snapshot_v6"
    "file_kind=chui_science_snapshot"
    "num_files_per_snapshot=1"
    "member_count=1"
    "member.0.filename=snap_001.hdf5")
  if(NOT runtime_smoke_completion_text MATCHES "${required_manifest_contract}")
    message(FATAL_ERROR
      "runtime smoke snapshot-set completion manifest is missing contract: "
      "${required_manifest_contract}")
  endif()
endforeach()

file(READ "${runtime_smoke_stdout}" runtime_stdout_text)
if(NOT runtime_stdout_text MATCHES "run_directory=${runtime_smoke_run_dir}")
  message(FATAL_ERROR "runtime smoke stdout must report the concrete run directory")
endif()
if(NOT runtime_stdout_text MATCHES "completed_steps=1")
  message(FATAL_ERROR "runtime smoke stdout must report completed_steps=1")
endif()

file(READ "${runtime_smoke_run_dir}/operational_events.json" runtime_ops)
if(NOT runtime_ops MATCHES "run.complete")
  message(FATAL_ERROR "runtime smoke operational report must record run.complete")
endif()
if(NOT runtime_ops MATCHES "config.freeze")
  message(FATAL_ERROR "runtime smoke operational report must record config.freeze")
endif()
if(NOT runtime_ops MATCHES "snapshot.write.complete")
  message(FATAL_ERROR "runtime smoke operational report must record snapshot.write.complete")
endif()
if(NOT runtime_ops MATCHES "scientifically read back, and independently validated as one logical set")
  message(FATAL_ERROR "runtime smoke must record successful scientific snapshot-set validation")
endif()

file(READ "${runtime_smoke_run_dir}/normalized_config.param.txt" runtime_normalized)
if(NOT runtime_normalized MATCHES "treepm_pm_grid_nx = 8")
  message(FATAL_ERROR "runtime smoke normalized config must preserve canonical numerics.treepm_pm_grid_nx")
endif()
if(NOT runtime_normalized MATCHES "treepm_pm_grid_ny = 8")
  message(FATAL_ERROR "runtime smoke normalized config must preserve canonical numerics.treepm_pm_grid_ny")
endif()
if(NOT runtime_normalized MATCHES "treepm_pm_grid_nz = 8")
  message(FATAL_ERROR "runtime smoke normalized config must preserve canonical numerics.treepm_pm_grid_nz")
endif()
if(NOT runtime_normalized MATCHES "treepm_asmth_cells = 1.5")
  message(FATAL_ERROR "runtime smoke normalized config must preserve numerics.treepm_asmth_cells")
endif()

# The smoke proves artifact creation above, then removes its temporary run tree
# so ordinary CTest execution does not leave runtime products in the source package.
file(REMOVE_RECURSE "${runtime_smoke_root}")
