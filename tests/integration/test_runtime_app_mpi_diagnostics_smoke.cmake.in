set(runtime_root "@CMAKE_BINARY_DIR@/runtime_app_mpi_diagnostics_smoke")
set(runtime_run_root "${runtime_root}/outputs")
set(runtime_config "${runtime_root}/runtime_mpi_diagnostics.param.txt")
set(runtime_stdout "${runtime_root}/runtime_stdout.txt")
set(runtime_stderr "${runtime_root}/runtime_stderr.txt")
set(runtime_shared_run_dir "${runtime_run_root}/runtime_app_mpi_diagnostics_smoke")
set(runtime_diagnostics_dir "${runtime_shared_run_dir}/diagnostics")
file(REMOVE_RECURSE "${runtime_root}")
file(MAKE_DIRECTORY "${runtime_root}")
file(WRITE "${runtime_config}" "schema_version = 1\n\n[mode]\nmode = zoom_in\nic_file = generated\nzoom_high_res_region = false\n\n[numerics]\ntime_begin_code = 0.01\ntime_end_code = 0.0101\nmax_global_steps = 1\nhierarchical_max_rung = 0\ngravity_solver = treepm\nhydro_solver = godunov_fv\ntreepm_pm_grid_nx = 16\ntreepm_pm_grid_ny = 16\ntreepm_pm_grid_nz = 16\ntreepm_assignment_scheme = cic\ntreepm_enable_window_deconvolution = true\ntreepm_update_cadence_steps = 1\n\n[analysis]\nenable_diagnostics = true\nenable_halo_workflow = false\nrun_health_interval_steps = 1\nscience_light_interval_steps = 1\nscience_heavy_interval_steps = 1\n\n[output]\nrun_name = runtime_app_mpi_diagnostics_smoke\noutput_directory = ${runtime_run_root}\noutput_stem = snap\nrestart_stem = restart\nsnapshot_interval_steps = 8\nsnapshot_layout = single\nwrite_restarts = false\n\n[parallel]\nmpi_ranks_expected = 2\nomp_threads = 1\ngpu_devices = 0\n\n[units]\ncoordinate_frame = comoving\n")
execute_process(
  COMMAND "@MPIEXEC_EXECUTABLE@" "@MPIEXEC_NUMPROC_FLAG@" "2" @MPIEXEC_PREFLAGS@
          "@CMAKE_BINARY_DIR@/cosmosim_harness" "${runtime_config}" @MPIEXEC_POSTFLAGS@
  RESULT_VARIABLE runtime_result OUTPUT_FILE "${runtime_stdout}" ERROR_FILE "${runtime_stderr}")
if(NOT runtime_result EQUAL 0)
  file(READ "${runtime_stderr}" runtime_err)
  message(FATAL_ERROR "MPI diagnostics smoke failed (${runtime_result}):\n${runtime_err}")
endif()
file(GLOB diagnostic_json "${runtime_diagnostics_dir}/diagnostics_*.json")
list(LENGTH diagnostic_json diagnostic_count)
if(NOT diagnostic_count GREATER 0)
  message(FATAL_ERROR "MPI diagnostics smoke did not publish a shared global diagnostics JSON")
endif()
file(GLOB diagnostic_parts "${runtime_diagnostics_dir}/*.part" "${runtime_shared_run_dir}/*.part")
if(diagnostic_parts)
  message(FATAL_ERROR "MPI diagnostics smoke left transactional .part files: ${diagnostic_parts}")
endif()
foreach(json_path IN LISTS diagnostic_json)
  file(READ "${json_path}" json_text)
  if(NOT json_text MATCHES [=["scope"[ \t]*:[ \t]*"global"]=])
    message(FATAL_ERROR "MPI diagnostics artifact is not labeled communicator-global: ${json_path}")
  endif()
  if(NOT json_text MATCHES [=["contributing_rank_count"[ \t]*:[ \t]*2]=])
    message(FATAL_ERROR "MPI diagnostics artifact has wrong contributing rank count: ${json_path}")
  endif()
endforeach()
# Heavy diagnostics under MPI must never publish an averaged local power spectrum.
file(GLOB heavy_json "${runtime_diagnostics_dir}/diagnostics_science_heavy_*.json")
foreach(json_path IN LISTS heavy_json)
  file(READ "${json_path}" heavy_text)
  if(NOT heavy_text MATCHES "unsupported_under_mpi_requires_global_density_fft")
    message(FATAL_ERROR "MPI heavy diagnostics must explicitly defer power spectrum without a global FFT contract")
  endif()
endforeach()
