if(NOT EXISTS "@CMAKE_BINARY_DIR@/cosmosim_feature_summary.txt")
  message(FATAL_ERROR "Feature summary text file was not generated.")
endif()
if(NOT EXISTS "@CMAKE_BINARY_DIR@/cosmosim_build_metadata.json")
  message(FATAL_ERROR "Build metadata JSON file was not generated.")
endif()

file(READ "@CMAKE_BINARY_DIR@/cosmosim_feature_summary.txt" feature_summary)
if(NOT feature_summary MATCHES "project=cosmosim")
  message(FATAL_ERROR "Feature summary does not contain project marker.")
endif()
if(NOT feature_summary MATCHES "targets=.*cosmosim_core")
  message(FATAL_ERROR "Feature summary does not list cosmosim_core target.")
endif()
if(NOT feature_summary MATCHES "cxx_compiler_path=.+")
  message(FATAL_ERROR "Feature summary does not record compiler path.")
endif()

function(expect_feature name configured_value)
  if("${configured_value}" STREQUAL "ON" OR "${configured_value}" STREQUAL "TRUE" OR "${configured_value}" STREQUAL "1")
    set(expected "true")
  else()
    set(expected "false")
  endif()
  if(NOT feature_summary MATCHES "feature_${name}=${expected}")
    message(FATAL_ERROR "Feature summary mismatch for ${name}: expected ${expected}\n${feature_summary}")
  endif()
endfunction()

expect_feature(mpi "@COSMOSIM_ENABLE_MPI@")
expect_feature(hdf5 "@COSMOSIM_ENABLE_HDF5@")
expect_feature(hdf5_parallel "@COSMOSIM_HDF5_PARALLEL@")
expect_feature(hdf5_mpio_probe "@COSMOSIM_HDF5_MPIO_CAPABILITY_PROBE@")
expect_feature(hdf5_parallel_required "@COSMOSIM_REQUIRE_PARALLEL_HDF5@")
expect_feature(fftw "@COSMOSIM_ENABLE_FFTW@")
expect_feature(fftw_mpi "@COSMOSIM_HAVE_FFTW_MPI@")
expect_feature(tests "@COSMOSIM_ENABLE_TESTS@")

if("@COSMOSIM_ENABLE_HDF5@" STREQUAL "ON")
  if(NOT feature_summary MATCHES "dependency_hdf5=.+")
    message(FATAL_ERROR "HDF5-enabled build does not report HDF5 dependency version")
  endif()
  if(NOT feature_summary MATCHES "hdf5_include_dirs=.+")
    message(FATAL_ERROR "HDF5-enabled build does not report HDF5 include provenance")
  endif()
  if(NOT feature_summary MATCHES "hdf5_libraries=.+")
    message(FATAL_ERROR "HDF5-enabled build does not report HDF5 library provenance")
  endif()
endif()

if("@COSMOSIM_REQUIRE_PARALLEL_HDF5@" STREQUAL "ON" AND NOT "@COSMOSIM_HDF5_PARALLEL@" STREQUAL "ON")
  message(FATAL_ERROR "A build requiring Parallel HDF5 reached the feature-summary test without qualified MPIO support")
endif()
