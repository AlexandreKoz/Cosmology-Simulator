set(root "@CMAKE_BINARY_DIR@/treepm_experiment_configs_test")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/base.param.txt" "[mode]\nic_file = generated\n[numerics]\ntreepm_pm_grid = 16\n")
execute_process(COMMAND "@CMAKE_BINARY_DIR@/cosmosim_treepm_experiment_configs"
  "${root}/base.param.txt" "${root}/decks" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "typed TreePM deck generation failed: ${error}")
endif()
foreach(name IN ITEMS reference optimized_matched matched_gaussian matched_full_residual matched_simd
    matched_radial matched_reuse matched_refit adaptive_025 adaptive_050_experimental)
  file(READ "${root}/decks/${name}.param.txt" text)
  if(NOT text MATCHES "hierarchical_max_rung = 0" OR NOT text MATCHES "treepm_residual_block_size = 64")
    message(FATAL_ERROR "experiment changed global KDK/block baseline: ${name}")
  endif()
  if(name STREQUAL "adaptive_050_experimental")
    if(NOT text MATCHES "treepm_adaptive_maximum_opening_angle = 0.5")
      message(FATAL_ERROR "experimental angle missing")
    endif()
  elseif(NOT text MATCHES "treepm_adaptive_maximum_opening_angle = 0.25")
    message(FATAL_ERROR "reference angle changed: ${name}")
  endif()
  if(name MATCHES "^adaptive_" AND NOT text MATCHES "treepm_adaptive_acceptance_enabled = true")
    message(FATAL_ERROR "adaptive experiment did not select adaptive acceptance")
  endif()
  if(name STREQUAL "reference" AND NOT text MATCHES "treepm_full_mac_diagnostics = true")
    message(FATAL_ERROR "reference lost forensic diagnostics")
  endif()
  if(name STREQUAL "optimized_matched" AND NOT text MATCHES "treepm_full_mac_diagnostics = false")
    message(FATAL_ERROR "matched experiment did not select fast diagnostics")
  endif()
endforeach()
execute_process(COMMAND "@CMAKE_BINARY_DIR@/cosmosim_treepm_experiment_configs"
  "${root}/base.param.txt" "${root}/decks" RESULT_VARIABLE duplicate_result)
if(duplicate_result EQUAL 0)
  message(FATAL_ERROR "generator overwrote an existing experiment")
endif()
file(REMOVE_RECURSE "${root}")
