@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(COSMOSIM_PACKAGE_WITH_OPENMP @COSMOSIM_HAVE_OPENMP@)
set(COSMOSIM_PACKAGE_WITH_MPI @COSMOSIM_ENABLE_MPI@)
set(COSMOSIM_PACKAGE_WITH_HDF5 @COSMOSIM_ENABLE_HDF5@)
set(COSMOSIM_PACKAGE_HDF5_PARALLEL @COSMOSIM_HDF5_PARALLEL@)
set(COSMOSIM_PACKAGE_REQUIRE_PARALLEL_HDF5 @COSMOSIM_REQUIRE_PARALLEL_HDF5@)
set(COSMOSIM_PACKAGE_WITH_FFTW @COSMOSIM_ENABLE_FFTW@)
set(COSMOSIM_PACKAGE_WITH_CUDA @COSMOSIM_ENABLE_CUDA@)

if(COSMOSIM_PACKAGE_WITH_OPENMP)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
if(COSMOSIM_PACKAGE_WITH_MPI)
  find_dependency(MPI COMPONENTS CXX)
endif()
if(COSMOSIM_PACKAGE_WITH_HDF5)
  if(COSMOSIM_PACKAGE_HDF5_PARALLEL)
    set(HDF5_PREFER_PARALLEL TRUE)
    if(NOT DEFINED HDF5_C_COMPILER_EXECUTABLE AND
       NOT DEFINED HDF5_ROOT AND NOT DEFINED HDF5_DIR)
      find_program(_COSMOSIM_HDF5_PARALLEL_C_WRAPPER
        NAMES h5pcc h5pcc.openmpi h5pcc.mpich)
      if(_COSMOSIM_HDF5_PARALLEL_C_WRAPPER)
        set(HDF5_C_COMPILER_EXECUTABLE
          "${_COSMOSIM_HDF5_PARALLEL_C_WRAPPER}" CACHE FILEPATH
          "Parallel HDF5 C wrapper preferred by installed CosmoSim package")
        set(HDF5_NO_FIND_PACKAGE_CONFIG_FILE TRUE)
      endif()
    endif()
  endif()
  find_dependency(HDF5 COMPONENTS C)
endif()

# Preserve the source-build dependency truth for downstream consumers. Package
# metadata records what CHUI itself was qualified against, while this probe
# verifies that the consumer resolved an HDF5/MPI family exposing the same MPIO
# APIs rather than silently substituting a serial HDF5 installation.
set(COSMOSIM_PACKAGE_CONSUMER_HDF5_MPIO_PROBE FALSE)
if(COSMOSIM_PACKAGE_HDF5_PARALLEL AND COSMOSIM_PACKAGE_WITH_MPI)
  include(CheckCXXSourceCompiles)
  set(_COSMOSIM_SAVED_REQUIRED_INCLUDES "${CMAKE_REQUIRED_INCLUDES}")
  set(_COSMOSIM_SAVED_REQUIRED_LIBRARIES "${CMAKE_REQUIRED_LIBRARIES}")
  set(CMAKE_REQUIRED_INCLUDES ${HDF5_INCLUDE_DIRS})
  if(TARGET HDF5::HDF5)
    set(CMAKE_REQUIRED_LIBRARIES HDF5::HDF5 MPI::MPI_CXX)
  else()
    set(CMAKE_REQUIRED_LIBRARIES ${HDF5_LIBRARIES} MPI::MPI_CXX)
  endif()
  check_cxx_source_compiles(
    "#include <mpi.h>\n#include <hdf5.h>\nint main(){ hid_t f=H5Pcreate(H5P_FILE_ACCESS); hid_t x=H5Pcreate(H5P_DATASET_XFER); if(f<0||x<0) return 1; if(H5Pset_fapl_mpio(f,MPI_COMM_WORLD,MPI_INFO_NULL)<0) return 2; if(H5Pset_dxpl_mpio(x,H5FD_MPIO_COLLECTIVE)<0) return 3; H5Pclose(x); H5Pclose(f); return 0; }"
    COSMOSIM_PACKAGE_CONSUMER_HDF5_MPIO_PROBE)
  set(CMAKE_REQUIRED_INCLUDES "${_COSMOSIM_SAVED_REQUIRED_INCLUDES}")
  set(CMAKE_REQUIRED_LIBRARIES "${_COSMOSIM_SAVED_REQUIRED_LIBRARIES}")
endif()
if(COSMOSIM_PACKAGE_REQUIRE_PARALLEL_HDF5 AND NOT COSMOSIM_PACKAGE_HDF5_PARALLEL)
  message(FATAL_ERROR "Installed CosmoSim package requires its qualified Parallel-HDF5 build contract, but package metadata does not report it.")
endif()
if(COSMOSIM_PACKAGE_REQUIRE_PARALLEL_HDF5 AND NOT COSMOSIM_PACKAGE_CONSUMER_HDF5_MPIO_PROBE)
  message(FATAL_ERROR
    "Installed CosmoSim package requires Parallel HDF5, but the consumer-resolved HDF5/MPI dependency family cannot compile/link H5Pset_fapl_mpio/H5Pset_dxpl_mpio.")
endif()
if(COSMOSIM_PACKAGE_WITH_FFTW)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  include("${CMAKE_CURRENT_LIST_DIR}/cosmosim_find_fftw.cmake")
  if(COSMOSIM_PACKAGE_WITH_MPI)
    cosmosim_find_fftw(COSMOSIM_FFTW_TARGET REQUIRE_MPI)
  else()
    cosmosim_find_fftw(COSMOSIM_FFTW_TARGET)
  endif()
endif()
if(COSMOSIM_PACKAGE_WITH_CUDA)
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CosmoSimTargets.cmake")
check_required_components(CosmoSim)
